# starship
eval "$(starship init bash)"
bind 'TAB:menu-complete'
# Bash completion v2
[[ -r "$(brew --prefix)/etc/profile.d/bash_completion.sh" ]] && source "$(brew --prefix)/etc/profile.d/bash_completion.sh"

# Add fzf for enhanced fuzzy searching
[ -f ~/.fzf.bash ] && source ~/.fzf.bash
export FZF_TMUX=1
export FZF_TMUX_HEIGHT=40%  # Adjust the height as needed
# Append rather than overwrite history
shopt -s histappend

# Ensure timestamps in history
export HISTTIMEFORMAT="%F %T "

# Set size limits
export HISTSIZE=10000
export HISTFILESIZE=20000

# Interactive search via fzf
fzf-history() {
    local selected=$(history | fzf | awk '{$1=""; print substr($0,2)}')
    if [ -n "$selected" ]; then
        READLINE_LINE=$selected
        READLINE_POINT=${#selected}
    fi
}

# Auto-start tmux in Ghostty
if [[ "$TERM_PROGRAM" == "ghostty" ]] && [ -z "$TMUX" ] && command -v tmux >/dev/null; then
  tmux attach-session -t ghostty || tmux new-session -s ghostty
fi
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

