# ------------------------------------------------------------------------------
# aliases.shrc — Shell aliases (git, docker, k8s, file ops, etc.)
# ------------------------------------------------------------------------------
# What it does:
#   Defines short aliases for common commands: g/gst/gd (git), dkps/dkl (docker),
#   kgp/kubectl (k8s), ls/ll/cat (eza/bat), lg (lazygit), and navigation (c, sz, cdh).
#
# How to interact:
#   Sourced from .zshrc at startup. Edit this file in repo (zsh/aliases.shrc);
#   reload with: source ~/.zshrc (or open a new terminal).
#
# Author: Casey A. Thayer
# Location: ~/.aliases.shrc (symlinked from repo)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 🐍 Python & Virtual Envs
# ------------------------------------------------------------------------------
alias python=python3
alias pip=pip3

# ------------------------------------------------------------------------------
# ✍️  Editor (EDITOR set in .zprofile for GUI/commit messages; here only aliases)
# ------------------------------------------------------------------------------
alias vim=nvim
alias vv=nvim

# ------------------------------------------------------------------------------
# 🪟 Dev session (Ghostty + tmux: Neovim + terminal + right pane) — opt-in via dev
# ------------------------------------------------------------------------------
# Run when you want this layout:  dev   → tmux session with nvim (main), shell (bottom 25%), right pane.
# To adjust: set CODE_BOTTOM_PCT, CODE_RIGHT_PCT, CODE_RIGHT_CMD (see scripts/code-session.sh).
# Repo path: defaults to ~/sys-config, then ~/ct/sys-config; or set SYS_CONFIG_REPO.
if [[ -z "${SYS_CONFIG_REPO-}" ]]; then
  if [[ -f "$HOME/sys-config/scripts/code-session.sh" ]]; then
    SYS_CONFIG_REPO="$HOME/sys-config"
  else
    SYS_CONFIG_REPO="$HOME/ct/sys-config"
  fi
fi
alias dev='bash "${SYS_CONFIG_REPO}/scripts/code-session.sh"'

# ------------------------------------------------------------------------------
# 💻 Shell & Navigation
# ------------------------------------------------------------------------------
alias ...='cd ../..'
alias c=clear
alias xx='exit'
alias rsh='exec $SHELL'
alias sz='source ~/.zshrc'

alias cdh='cd $HOME'
alias cdm='cd $HOME/ct'
alias cdc='cd $HOME/ct/sys-config'
alias pie='cd $HOME/phillies/pie'
alias terraform='cd $HOME/phillies/terraform'

# ------------------------------------------------------------------------------
# 📂 File Listing
# ------------------------------------------------------------------------------
alias ls='eza -l --icons'
alias ll='eza -l -a --icons'
alias cat='bat'

# ------------------------------------------------------------------------------
# 🔐 Direnv
# ------------------------------------------------------------------------------
alias da='direnv allow'
alias dr='direnv reload'

# ------------------------------------------------------------------------------
# 🔧 Git
# ------------------------------------------------------------------------------
alias g='git'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gl='git log --oneline'
alias gst='git status'
alias gd='git diff'
alias gdc='git diff --cached'
alias gm='git commit -m'
alias gma='git commit -am'
alias gb='git branch'
alias gco='git checkout'
alias gra='git remote add'
alias grr='git remote rm'
alias gpu='git pull'
alias gf='git fetch'
alias gcl='git clone'
alias gcpr="gh pr create -w"
alias gsync="git checkout main && git pull --rebase && git fetch --prune"
alias glom="git pull origin main"
alias lg=lazygit
alias ld=lazydocker       # TUI for docker containers, logs, and images
alias ts=tmux-sessionizer # fuzzy-jump to project dir / create tmux session
alias ppp='security find-generic-password -s com.phillies.onboarding.generate-ssh-key -w'

# ------------------------------------------------------------------------------
# 🐳 Docker
# ------------------------------------------------------------------------------
alias dkps='docker ps'
alias dkpsa='docker ps -a'
alias dkimgs='docker images'
alias dkst='docker stats'
alias dkl='docker logs -f'
alias dke='docker exec -it'
alias dkclean='docker rm $(docker ps -aq)'
alias dk-up='docker-compose up -d'
alias dk-down='docker-compose down'
alias dk-start='docker-compose start'
alias dk-stop='docker-compose stop'
alias dk-clean='docker system prune -a --volumes'

# ------------------------------------------------------------------------------
# ☸️ Kubernetes (functions used for args)
# ------------------------------------------------------------------------------
ka() { kubectl apply -f "$1"; }
kdj() { kubectl delete job "$1"; }
alias kgp='kubectl get pods'
alias kgj='kubectl get jobs'
alias kjr='kubectl get jobs | grep Running'
alias kjf='kubectl get jobs | grep Failed'

# ------------------------------------------------------------------------------
# 📊 R
# ------------------------------------------------------------------------------
alias R='R --no-restore-data --no-save'
alias r='radian'

# ------------------------------------------------------------------------------
# 🦆 DuckDB
# ------------------------------------------------------------------------------
alias duckdb='/Applications/duckdb'

# ------------------------------------------------------------------------------
# 🛠️ Terraform
# ------------------------------------------------------------------------------
alias tf='./terraform.sh'

# ------------------------------------------------------------------------------
# 🔍 System & Network
# ------------------------------------------------------------------------------
alias ports='lsof -i -P -n | grep LISTEN'
alias ip='curl ifconfig.me'
alias devip='ipconfig getifaddr en0'

# ------------------------------------------------------------------------------
# 🥞 Phillies DBs
# ------------------------------------------------------------------------------
alias db-proxy-prod='cloud-sql-proxy phil-new:us-east1:phil-db-prod-v2 --port 3306 --structured-logs'
alias db-cli-prod='mycli -h 127.0.0.1 -P 3306 -u $PHIL_DB_PROD_ADMIN_USER -p $PHIL_DB_PROD_ADMIN_PASS'
