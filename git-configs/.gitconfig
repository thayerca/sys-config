# ------------------------------------------------------------------------------
# 🧬 .gitconfig — Global Git Configuration
# ------------------------------------------------------------------------------
# Description:
#   Streamlined git configuration for command-line and tool integrations.
#   Includes enhanced diffing, merge tooling, delta, LFS, and GitHub CLI support.
#
# Author: Casey A. Thayer
# Location: ~/.gitconfig
# ------------------------------------------------------------------------------

[user]
  name = thayerca
  email = casey.thayer6@gmail.com

[init]
  defaultBranch = main

[core]
  excludesfile = ~/.gitignore_global
  autocrlf = false
  eol = lf
  pager = delta

[github]
  user = thayerca

[hub]
  protocol = https

# ------------------------------------------------------------------------------
# 🧪 Diffs & Difftools
# ------------------------------------------------------------------------------

[diff]
  tool = nvimdiff
  colorMoved = default

[difftool]
  prompt = false

[difftool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$REMOTE"
  path = /opt/homebrew/bin/nvim

# ------------------------------------------------------------------------------
# 🧠 Merge Tools
# ------------------------------------------------------------------------------

[merge]
  conflictstyle = diff3

[mergetool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$REMOTE" -ancestor "$BASE" -merge "$MERGED"
  trustExitCode = true

# ------------------------------------------------------------------------------
# 🧩 Git LFS
# ------------------------------------------------------------------------------

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

# ------------------------------------------------------------------------------
# 🎨 Delta for Pretty Diffs
# ------------------------------------------------------------------------------

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true        # Enable n/N navigation between diff hunks
  light = false          # Set to true for light backgrounds

[color]
  ui = true

[color "diff-highlight"]
  oldNormal    = red bold
  oldHighlight = red bold 52
  newNormal    = green bold
  newHighlight = green bold 22

[color "diff"]
  meta       = 11
  frag       = magenta bold
  func       = 146 bold
  commit     = yellow bold
  old        = red bold
  new        = green bold
  whitespace = red reverse
[url "git@github.com:"]
	insteadOf = https://github.com/
